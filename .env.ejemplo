# 1. Copia este archivo y nómbralo exactamente:  .env
# 2. Pega tu token después del signo = (sin espacios ni comillas)
TELEGRAM_TOKEN=pega_aqui_tu_token

# Texto secreto para crear el ID anónimo del registro (escribe cualquier palabra)
SAL_ANONIMO=cambia_esta_palabra

# IDs de Telegram que pueden usar /conteo, separados por comas.
# Para saber tu ID, enciende el bot y escríbele /miid
ADMIN_IDS=
